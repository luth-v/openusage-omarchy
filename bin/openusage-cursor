"""Collect Cursor plan quotas; adapted from janhoon.agents."""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import sqlite3
import sys
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any

AGENT_ID = "cursor"
AGENT_NAME = "Cursor"
AUTH_HELP = "Sign in to Cursor to restore authoritative usage."
USAGE_URL = "https://api2.cursor.sh/aiserver.v1.DashboardService/GetCurrentPeriodUsage"
PLAN_URL = "https://api2.cursor.sh/aiserver.v1.DashboardService/GetPlanInfo"
PROBE_MIN_INTERVAL_SECONDS = 15


def config_home() -> Path:
  return Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))


def cursor_user_dir() -> Path:
  return config_home() / "Cursor" / "User"


def cache_root() -> Path:
  root = Path(os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache")) / "openusage"
  root.mkdir(parents=True, exist_ok=True)
  return root


def number(value: Any) -> int:
  try:
    return max(0, round(float(value or 0)))
  except (TypeError, ValueError):
    return 0


def write_json(path: Path, payload: dict[str, Any]) -> None:
  handle_fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
  tmp = Path(tmp_name)
  try:
    with os.fdopen(handle_fd, "w", encoding="utf-8") as handle:
      handle.write(json.dumps(payload, separators=(",", ":"), sort_keys=True) + "\n")
    tmp.chmod(0o600)
    tmp.replace(path)
  except BaseException:
    tmp.unlink(missing_ok=True)
    raise


def read_fresh_json(path: Path, max_age_seconds: float) -> dict[str, Any] | None:
  if max_age_seconds <= 0 or not path.exists():
    return None
  try:
    age = time.time() - path.stat().st_mtime
    if 0 <= age <= max_age_seconds:
      parsed = json.loads(path.read_text(encoding="utf-8"))
      return parsed if isinstance(parsed, dict) else None
  except Exception:
    return None
  return None


def decode_cell(value: Any) -> str:
  if isinstance(value, bytes):
    return value.decode("utf-8", "replace")
  return "" if value is None else str(value)


def read_item(conn: sqlite3.Connection, key: str) -> str:
  try:
    row = conn.execute("SELECT value FROM ItemTable WHERE key = ?", (key,)).fetchone()
  except sqlite3.Error:
    return ""
  return decode_cell(row[0]) if row else ""


def open_readonly(path: Path) -> sqlite3.Connection | None:
  if not path.is_file():
    return None
  try:
    conn = sqlite3.connect(path.resolve().as_uri() + "?mode=ro", uri=True, timeout=2)
    conn.execute("PRAGMA query_only = ON")
    return conn
  except sqlite3.Error:
    return None


def cursor_login() -> tuple[str, str, str]:
  db = cursor_user_dir() / "globalStorage" / "state.vscdb"
  conn = open_readonly(db)
  if conn is None:
    return "", "", ""
  try:
    token = read_item(conn, "cursorAuth/accessToken").strip()
    plan = read_item(conn, "cursorAuth/stripeMembershipType").strip()
    status = read_item(conn, "cursorAuth/stripeSubscriptionStatus").strip()
    return token, plan, status
  finally:
    conn.close()


def post_json(url: str, token: str) -> dict[str, Any]:
  request = urllib.request.Request(
    url,
    data=b"{}",
    method="POST",
    headers={
      "Authorization": "Bearer " + token,
      "Accept": "application/json",
      "Content-Type": "application/json",
      "Connect-Protocol-Version": "1",
    },
  )
  with urllib.request.urlopen(request, timeout=12) as response:
    payload = json.loads(response.read().decode("utf-8", errors="replace"))
  return payload if isinstance(payload, dict) else {}


def iso_from_ms(value: Any) -> str:
  raw = str(value or "").strip()
  if raw == "":
    return ""
  try:
    ms = int(raw)
  except ValueError:
    return raw
  if ms < 1e12:
    ms *= 1000
  if ms <= 0:
    return ""
  try:
    return dt.datetime.fromtimestamp(ms / 1000, dt.timezone.utc).isoformat()
  except Exception:
    return ""


def plan_label(remote_name: str, local_plan: str, local_status: str) -> str:
  name = (remote_name or local_plan or "").strip()
  if not name:
    return ""
  label = name[0].upper() + name[1:] if name.islower() else name
  if local_status and local_status.lower() not in ("", "active"):
    return f"{label} ({local_status})"
  return label


def fraction(used: Any, limit: Any) -> float:
  try:
    denom = float(limit)
    numer = float(used)
  except (TypeError, ValueError):
    return -1.0
  if denom <= 0 or numer < 0:
    return -1.0
  return min(1.0, numer / denom)


def pool_fraction(value: Any) -> float:
  try:
    pct = float(value)
  except (TypeError, ValueError):
    return -1.0
  if pct < 0:
    return -1.0
  return min(1.0, pct / 100.0)


def limits_from_usage(payload: dict[str, Any]) -> list[dict[str, Any]]:
  out: list[dict[str, Any]] = []
  plan = payload.get("planUsage") if isinstance(payload.get("planUsage"), dict) else {}
  spend_cap = payload.get("spendLimitUsage") if isinstance(payload.get("spendLimitUsage"), dict) else {}
  reset_at = iso_from_ms(payload.get("billingCycleEnd"))

  auto_pct = pool_fraction(plan.get("autoPercentUsed"))
  if auto_pct >= 0:
    out.append({
      "label": "Cursor Models",
      "title": "Cursor",
      "percent": auto_pct,
      "resetsAt": reset_at,
    })

  api_pct = pool_fraction(plan.get("apiPercentUsed"))
  if api_pct >= 0:
    out.append({
      "label": "Other Models",
      "title": "Other",
      "percent": api_pct,
      "resetsAt": reset_at,
    })

  if not out:
    included_limit = number(plan.get("limit"))
    included_used = number(plan.get("includedSpend", plan.get("totalSpend")))
    if included_limit <= 0:
      included_used = number(plan.get("totalSpend"))
      included_limit = included_used + number(plan.get("remaining"))
    percent = fraction(included_used, included_limit)
    if percent >= 0:
      out.append({
        "label": "Monthly included",
        "title": "Monthly",
        "percent": percent,
        "resetsAt": reset_at,
      })

  cap_limit = number(spend_cap.get("individualLimit"))
  cap_used = number(spend_cap.get("individualUsed", spend_cap.get("totalSpend")))
  cap_percent = fraction(cap_used, cap_limit)
  if cap_percent >= 0:
    out.append({
      "label": "On-demand cap",
      "title": "On-demand",
      "percent": cap_percent,
      "resetsAt": reset_at,
    })
  return out


def probe_cursor(token: str) -> dict[str, Any]:
  try:
    usage = post_json(USAGE_URL, token)
    try:
      plan = post_json(PLAN_URL, token)
    except Exception:
      plan = {}
  except urllib.error.HTTPError as error:
    return {
      "ok": False,
      "helpText": f"Cursor's usage endpoint returned status {error.code}.",
    }
  except Exception:
    return {
      "ok": False,
      "transport": True,
      "helpText": "Couldn't reach Cursor's usage endpoint. Retrying shortly.",
    }

  limits = limits_from_usage(usage)
  remote_plan = ""
  info = plan.get("planInfo") if isinstance(plan.get("planInfo"), dict) else {}
  remote_plan = str(info.get("planName") or "")
  if not limits:
    return {"ok": False, "helpText": "Cursor's usage endpoint returned no limits."}
  return {"ok": True, "limits": limits, "tierLabel": remote_plan}


def limit_window_open(entry: dict[str, Any], now: dt.datetime) -> bool:
  raw = str(entry.get("resetsAt") or "")
  if raw == "":
    return True
  try:
    resets_at = dt.datetime.fromisoformat(raw.replace("Z", "+00:00"))
  except Exception:
    return True
  if resets_at.tzinfo is None:
    resets_at = resets_at.replace(tzinfo=dt.timezone.utc)
  return resets_at > now


def usable_cached_limits(cached: dict[str, Any]) -> list[dict[str, Any]]:
  entries = cached.get("limits")
  if not isinstance(entries, list):
    return []
  now = dt.datetime.now(dt.timezone.utc)
  return [entry for entry in entries if isinstance(entry, dict) and limit_window_open(entry, now)]


def collect_limits(token: str, local_plan: str, local_status: str, force: bool) -> dict[str, Any]:
  result = {
    "limits": [],
    "tierLabel": plan_label("", local_plan, local_status),
    "usageStatusText": "",
    "authHelpText": AUTH_HELP,
  }
  probe_cache = cache_root() / "cursor-limits.json"
  cached = read_fresh_json(probe_cache, float("inf")) or {}
  fallback = usable_cached_limits(cached)
  if cached.get("tierLabel"):
    result["tierLabel"] = plan_label(str(cached.get("tierLabel")), local_plan, local_status)

  if token == "":
    result["limits"] = fallback
    result["usageStatusText"] = "Waiting for auth"
    return result

  fetched_at = number(cached.get("fetchedAtMs")) / 1000
  if fallback and not force and time.time() - fetched_at < PROBE_MIN_INTERVAL_SECONDS:
    result["limits"] = fallback
    result["authHelpText"] = ""
    return result

  probe = probe_cursor(token)
  if probe.get("ok"):
    result["limits"] = probe["limits"]
    result["tierLabel"] = plan_label(str(probe.get("tierLabel") or ""), local_plan, local_status)
    try:
      write_json(probe_cache, {
        "fetchedAtMs": round(time.time() * 1000),
        "limits": probe["limits"],
        "tierLabel": result["tierLabel"],
      })
    except Exception as exc:
      print(f"omarchy-agent-usage-cursor: could not write limits cache ({exc})", file=sys.stderr)
    result["authHelpText"] = ""
    return result

  if probe.get("transport"):
    result["retryAdvised"] = True
  result["authHelpText"] = str(probe.get("helpText") or AUTH_HELP)
  result["usageStatusText"] = "Refresh failed"
  if fallback:
    result["limits"] = fallback
  else:
    result["usageStatusText"] = "Cursor limits unavailable"
    result["authHelpText"] = str(probe.get("helpText") or AUTH_HELP)
  return result


def main() -> int:
  parser = argparse.ArgumentParser()
  parser.add_argument("--force", action="store_true")
  parser.add_argument("--limits-only", action="store_true")
  args = parser.parse_args()

  token, local_plan, local_status = cursor_login()
  limits = collect_limits(token, local_plan, local_status, args.force)

  record = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
    "ready": bool(limits["limits"]),
    "tierLabel": limits["tierLabel"],
    "usageStatusText": limits["usageStatusText"],
    "authHelpText": limits["authHelpText"],
    "limits": limits["limits"],
  }
  if limits.get("retryAdvised"):
    record["retryAdvised"] = True
  print(json.dumps(record, separators=(",", ":"), sort_keys=True))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
