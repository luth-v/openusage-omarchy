#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -uo pipefail
case "${1:-}" in ''|--force|--limits-only) ;; *) exit 2 ;; esac
(( $# <= 1 )) || exit 2
umask 077
state="$HOME/.local/state/openusage"
mkdir -p "$state"
exec 9>"$state/update.lock"
flock 9
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
stock="${OMARCHY_PATH:-/usr/share/omarchy}/bin"
collect() {
  local id=$1 command=$2 tmp
  shift 2
  tmp=$(mktemp "$state/.$id.XXXXXX") || return 1
  if "$command" "$@" >"$tmp" && jq -e 'type == "object" and .schemaVersion == 1 and (.limits | type == "array")' "$tmp" >/dev/null; then
    chmod 600 "$tmp" && mv -f "$tmp" "$state/$id.json"
  else
    rm -f "$tmp"
    printf 'OpenUsage: %s collector failed\n' "$id" >&2
    return 1
  fi
}
pids=()
while read -r id command; do
  collect "$id" "$command" "$@" &
  pids+=("$!")
done <<ROWS
claude $stock/omarchy-agent-usage-claude
codex $stock/omarchy-agent-usage-codex
cursor $here/openusage-cursor
opencode $here/openusage-opencode
grok $here/openusage-grok
ROWS
status=0
for pid in "${pids[@]}"; do wait "$pid" || status=1; done
exit "$status"
