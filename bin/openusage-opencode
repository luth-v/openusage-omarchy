#!/usr/bin/python3
"""Read OpenCode Go/Zen quotas without exposing credentials."""
# SPDX-License-Identifier: MIT
import argparse
import datetime as dt
import hashlib
import json
import math
import os
from pathlib import Path
import tempfile
import time
import urllib.request
import urllib.error

URL = 'https://opencode.ai/zen/go/v1/usage'
AUTH_HELP = 'Log in to OpenCode Go/Zen with /connect in OpenCode.'


def parse_limits(payload):
    if not isinstance(payload, dict) or 'error' in payload:
        raise ValueError('Invalid quota response')
    usage = payload.get('usage')
    if not isinstance(usage, dict):
        raise ValueError('Missing quota windows')
    limits = []
    for key, title in [('rolling', 'Session'), ('weekly', 'Weekly'), ('monthly', 'Monthly')]:
        window = usage.get(key)
        if not isinstance(window, dict):
            continue
        percent = window.get('percent')
        reset = window.get('resetsAt')
        if type(percent) not in (int, float) or not math.isfinite(percent) or not 0 <= percent <= 100:
            continue
        try:
            stamp = dt.datetime.fromisoformat(reset.replace('Z', '+00:00'))
            if stamp.tzinfo is None:
                continue
        except (ValueError, TypeError, AttributeError):
            continue
        limits.append(dict(label='Session (5-hour)' if key == 'rolling' else title,
                           title=title, percent=percent / 100, resetsAt=stamp.isoformat()))
    if not limits:
        raise ValueError('No valid quota windows')
    return limits


def read_json(path):
    try:
        value = json.loads(path.read_text())
        return value if isinstance(value, dict) else {}
    except (OSError, ValueError):
        return {}


def collect(force=False):
    now = dt.datetime.now(dt.timezone.utc)
    record = dict(schemaVersion=1, id='opencode', name='OpenCode', updatedAt=now.isoformat(),
                  ready=False, limits=[], tierLabel='Go/Zen', usageStatusText='Not logged in', authHelpText=AUTH_HELP)
    data = Path(os.environ.get('OPENCODE_DATA_DIR') or Path.home()/'.local/share/opencode')
    auth = read_json(data/'auth.json')
    key = ''
    for provider in ('opencode-go', 'opencode'):
        entry = auth.get(provider)
        if isinstance(entry, dict) and entry.get('type') == 'api' and isinstance(entry.get('key'), str):
            key = entry['key'].strip()
            if key:
                break
    if not key:
        return record
    cache_dir = Path(os.environ.get('XDG_CACHE_HOME') or Path.home()/'.cache')/'openusage'
    cache_dir.mkdir(parents=True, exist_ok=True)
    cache_path = cache_dir/'opencode-limits.json'
    cached = read_json(cache_path)
    identity = hashlib.sha256(key.encode()).hexdigest()
    if cached.get('identity') != identity:
        cached = {}
    fallback = []
    for window in cached.get('limits', []):
        try:
            if dt.datetime.fromisoformat(window['resetsAt']) > now:
                fallback.append(window)
        except (KeyError, ValueError, TypeError):
            pass
    record.update(limits=fallback, usageStatusText='', authHelpText='')
    if fallback and not force and 0 <= time.time()-cached.get('fetchedAt', 0) < 15:
        record['ready'] = True
        return record
    try:
        request = urllib.request.Request(URL, headers={'Authorization': 'Bearer '+key, 'Accept': 'application/json'})
        with urllib.request.urlopen(request, timeout=12) as response:
            limits = parse_limits(json.load(response))
        record['limits'] = limits
        fd, name = tempfile.mkstemp(dir=cache_dir, prefix='.opencode-')
        try:
            with os.fdopen(fd, 'w') as output:
                json.dump(dict(identity=identity, fetchedAt=time.time(), limits=limits), output)
            os.replace(name, cache_path)
        finally:
            Path(name).unlink(missing_ok=True)
    except urllib.error.HTTPError as error:
        record.update(usageStatusText='Refresh failed', authHelpText=f'OpenCode returned HTTP {error.code}. '+(AUTH_HELP if error.code in (401,403) else 'Try refreshing again.'))
    except (OSError, ValueError, TypeError):
        record.update(usageStatusText='Refresh failed', authHelpText='OpenCode quotas unavailable. Try refreshing again.')
    record['ready'] = bool(record['limits'])
    return record


if __name__ == '__main__':
    parser = argparse.ArgumentParser()
    parser.add_argument('--force', action='store_true')
    parser.add_argument('--limits-only', action='store_true')
    print(json.dumps(collect(parser.parse_args().force), allow_nan=False))
